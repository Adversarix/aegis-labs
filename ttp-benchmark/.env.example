# Copy to .env and fill in, or export these in your shell.

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Kimi K3 via Fireworks AI — OpenAI-compatible endpoint
# Model id: accounts/fireworks/models/kimi-k3
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Kimi K3 (Moonshot AI, direct) — only if using the Moonshot route instead
# International: https://api.moonshot.ai/v1   |  China: https://api.moonshot.cn/v1
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Qwen (Alibaba DashScope) — OpenAI-compatible endpoint
# International: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen via Ollama (local, open-weight only — NOT qwen3-max). Ollama ignores
# the key but the OpenAI SDK needs a non-empty value, so any placeholder works.
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
